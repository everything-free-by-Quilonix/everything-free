# Public URL the site is served from, with no trailing slash. It sets canonical
# URLs, the sitemap, OpenGraph tags and — through its path — the base path the
# static export is built for:
#   https://everything-free-by-quilonix.github.io/everything-free  → basePath /everything-free
#   http://localhost:3000                                         → no basePath
# When unset it defaults to the GitHub Pages address above (src/config/deployment.ts).
# In the deploy workflow it comes from the Pages configuration, so it is not set here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# There is intentionally nothing else here. The project has no database, no
# authentication, no analytics and no third-party API keys.
