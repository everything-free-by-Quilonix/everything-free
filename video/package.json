{
  "name": "everything-free-launch-film",
  "version": "1.0.0",
  "private": true,
  "description": "Everything.Free launch film — Remotion workspace. Isolated from the website build.",
  "license": "UNLICENSED",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "capture": "node scripts/capture-references.mjs",
    "audio": "node scripts/synth-audio.mjs",
    "typecheck": "tsc --noEmit",
    "still": "node scripts/render-stills.mjs",
    "render:master": "remotion render src/index.ts EverythingFreeLaunch out/everything-free-launch-4k.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --scale=2",
    "render:1080": "remotion render src/index.ts EverythingFreeLaunch out/everything-free-launch-1080p.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=256k",
    "render:vertical": "remotion render src/index.ts EverythingFreeVertical out/everything-free-launch-vertical-1080x1920.mp4 --codec=h264 --crf=17 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=256k",
    "render:cutdown": "remotion render src/index.ts EverythingFreeCutdown15 out/everything-free-cutdown-15s-1080p.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=256k",
    "render:all": "npm run render:master && npm run render:1080 && npm run render:vertical && npm run render:cutdown"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@remotion/cli": "4.0.535",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "playwright-core": "1.64.0",
    "typescript": "5.9.3"
  }
}
